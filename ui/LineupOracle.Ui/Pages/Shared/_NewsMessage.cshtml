@model LineupOracle.Ui.Pages.IndexModel
@using LineupOracle.Ui
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UiText> T
@if (!string.IsNullOrWhiteSpace(Model.ApiError))
{
    <p class="error-message">@Model.ApiError</p>
}
@if (Model.IsUnavailable)
{
    <div id="service-banner" class="service-banner" hx-swap-oob="outerHTML" role="status">
        <span class="banner-copy">@Model.ApiError</span>
        <a class="button button-warning"
           href="/?handler=Lineup&amp;matchId=@Uri.EscapeDataString(Model.SelectedMatchId)&amp;club=@Uri.EscapeDataString(Model.SelectedClub)&amp;mode=@Model.Mode"
           hx-get="/?handler=Lineup&amp;matchId=@Uri.EscapeDataString(Model.SelectedMatchId)&amp;club=@Uri.EscapeDataString(Model.SelectedClub)&amp;mode=@Model.Mode"
           hx-target="#lineup" hx-swap="outerHTML">@T["Retry"]</a>
    </div>
}
