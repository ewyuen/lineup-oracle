@model LineupOracle.Ui.Pages.IndexModel
@using LineupOracle.Ui
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UiText> T
<div id="service-banner" class="service-banner" role="status" hidden="@(!Model.IsUnavailable)">
    @if (Model.IsUnavailable)
    {
        var retryMatchId = Model.RetryMatchId ?? Model.SelectedMatchId;
        var retryClub = Model.RetryClub ?? Model.SelectedClub;
        <span class="banner-copy">@T["ServiceUnavailable"]</span>
        <a class="button button-warning" asp-page="/Index" asp-page-handler="Lineup"
           asp-route-matchId="@retryMatchId" asp-route-club="@retryClub" asp-route-mode="@Model.Mode"
           hx-get="/?handler=Lineup&amp;matchId=@Uri.EscapeDataString(retryMatchId)&amp;club=@Uri.EscapeDataString(retryClub)&amp;mode=@Model.Mode"
           hx-target="#workspace" hx-swap="outerHTML">@T["Retry"]</a>
    }
</div>
