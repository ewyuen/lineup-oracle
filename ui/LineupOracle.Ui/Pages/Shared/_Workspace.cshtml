@model LineupOracle.Ui.Pages.IndexModel
@using LineupOracle.Ui
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UiText> T
<div id="workspace" hx-get="/?handler=Lineup&amp;matchId=@Uri.EscapeDataString(Model.SelectedMatchId)&amp;club=@Uri.EscapeDataString(Model.SelectedClub)&amp;mode=@Model.Mode"
     hx-trigger="lineup-changed from:body" hx-swap="outerHTML">
    <div class="content-grid">
        <aside class="context-rail">
            @await Html.PartialAsync("_FixturePicker", Model)
            @await Html.PartialAsync("_TeamNews", Model)
        </aside>
        <section class="pitch-column" aria-label="@T["Lineup"]">
            @await Html.PartialAsync("_Lineup", Model)
        </section>
    </div>
</div>
@if (Model.RefreshNewsBar)
{
    @await Html.PartialAsync("_NewsBar", Model)
}
