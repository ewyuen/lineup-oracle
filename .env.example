# Copy to .env (gitignored) in the repo root. Real environment variables win over this file.
# The model is on only when endpoint and deployment are both set.
LINEUP_LLM_ENDPOINT=https://<your-resource>.openai.azure.com/
LINEUP_LLM_DEPLOYMENT=<your deployment name>
# Optional: leave out to use Azure sign-in (az login / managed identity).
LINEUP_LLM_API_KEY=
# Optional, seconds (default 15).
LINEUP_LLM_TIMEOUT=15
